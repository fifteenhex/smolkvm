# Smoke test: download a Linux kernel and smolutils, build a minimal vmlinux
# with the shipped config, use smolutils as the initramfs, and boot the whole
# lot under smolkvm -- passing if the guest reaches an interactive shell.
#
#   make -f Makefile.test run-gpu     # boot it with a display and leave it up
#   make -f Makefile.test run-doom    # ...with doom in the rootfs too
#   make -f Makefile.test smoke       # the whole pipeline, as a pass/fail
#   make -f Makefile.test smoke-gpu   # ...and again with the display
#   make -f Makefile.test kernel      # just build vmlinux
#   make -f Makefile.test initramfs   # just build the smolutils initramfs
#   make -f Makefile.test doom        # just build doom and fetch its wad
#   make -f Makefile.test clean       # drop build products, keep the downloads
#   make -f Makefile.test distclean   # drop the build directory entirely
#
# Nothing checked in lives under the build directory, so deleting it is always
# safe: the kernel config fragments the build needs are in test/.
#
# smoke-gpu stops the VM as soon as it has decided; run-gpu is the one to use
# when you want to look at the screen.
#
# Needs KVM (the boot runs a real VM) and, on Debian / Ubuntu:
#   build-essential flex bison bc libelf-dev libssl-dev   # kernel (libelf is
#                                                          # for objtool)
#   git meson libarchive-dev libcjson-dev libcap-dev      # tarwak
#   libarchive-tools                                      # bsdtar, for the cpio

# TESTDIR is checked in and must survive; BUILDDIR is everything downloaded,
# unpacked, cloned or built and can be deleted at any time to start over.
TESTDIR  := test
BUILDDIR := build

# An -rc, because smolutils' smolsh calls getcwd() and nolibc only grew one
# after 7.2. Release tarballs live under cdn.kernel.org/pub/linux/kernel/vX.x/
# and -rc ones are generated on demand at git.kernel.org/torvalds/t/, where they
# are also dropped again once the next -rc lands -- so this needs bumping now
# and then until 7.3 is out and it can go back to a release.
KERNEL_VERSION := 7.3-rc3
KERNEL_SRC     := $(BUILDDIR)/linux-$(KERNEL_VERSION)
KERNEL_TARBALL := $(BUILDDIR)/linux-$(KERNEL_VERSION).tar.gz
KERNEL_URL     := https://git.kernel.org/torvalds/t/linux-$(KERNEL_VERSION).tar.gz
KERNEL_STAMP   := $(BUILDDIR)/.linux-$(KERNEL_VERSION).extracted

# Out-of-tree build so re-extracting is never needed and the source stays clean.
KOUT    := $(CURDIR)/$(KERNEL_SRC)/smolkvm-build
VMLINUX := $(KOUT)/vmlinux
CONFIG  := $(CURDIR)/$(TESTDIR)/kernel.config

# The virtio-gpu smoke test needs DRM and the VT layer, which the base config
# deliberately leaves out, so it gets a config and a build directory of its own
# rather than making the plain boot drag a display around.
GPU_KOUT    := $(CURDIR)/$(KERNEL_SRC)/smolkvm-build-gpu
GPU_VMLINUX := $(GPU_KOUT)/vmlinux
GPU_CONFIG  := $(CURDIR)/$(TESTDIR)/kernel-gpu.config
GPU_MERGED  := $(CURDIR)/$(BUILDDIR)/kernel-gpu.merged

# --- userspace: smolutils ----------------------------------------------------

SMOLUTILS_URL := https://github.com/fifteenhex/smolutils.git
TARWAK_URL    := https://github.com/fifteenhex/tarwak.git
NOLIBCEXT_URL := https://github.com/fifteenhex/nolibc-extensions.git

SMOLUTILS_SRC := $(BUILDDIR)/smolutils
TARWAK_SRC    := $(BUILDDIR)/tarwak
TARWAK_BIN    := $(CURDIR)/$(TARWAK_SRC)/build/tarwak
NOLIBCEXT_SRC := $(BUILDDIR)/nolibc-extensions

# smolutils builds against nolibc; take it from the kernel tree we already
# unpack rather than fetching a second copy. The extensions on top (sockets,
# fcntl, the signal bits) are their own repo, and smolutils insists on being
# told where they are.
NOLIBCDIR    := $(CURDIR)/$(KERNEL_SRC)/tools/include/nolibc
NOLIBCEXTDIR := $(CURDIR)/$(NOLIBCEXT_SRC)

# Building x86-64 on x86-64: the host's triple-prefixed toolchain is a fine
# "cross" toolchain, so no separate download.
SMOLUTILS_CROSS := x86_64-linux-gnu-
SMOLUTILS_UAPI  := /usr/include /usr/include/x86_64-linux-gnu

# The net utilities want socket headers nolibc does not ship, and the smoke
# boot has no network anyway, so leave them out.
SMOLUTILS_FEATURE_DISABLE := net

# smolutils always writes x86_64.cpio.gz, so both rootfs builds land on the
# same file. Keep a copy of each under our own name; otherwise whichever was
# built last is the one both smoke tests boot.
SMOLUTILS_CPIO := $(CURDIR)/$(SMOLUTILS_SRC)/x86_64.cpio.gz
INITRAMFS      := $(CURDIR)/$(BUILDDIR)/x86_64.cpio.gz

# --- userspace: doom ---------------------------------------------------------
#
# The rootfs can also carry doomgeneric drawing through smol2d's DRM backend,
# which is what the virtio-gpu is for. Only the `doom` and `smoke-gpu` targets
# touch any of it, so a plain `smoke` is unaffected.
#
# doomgeneric packages itself: its Makefile.rootfs fetches smol2d and the wad
# and leaves a tarball. All it wants from here is the nolibc out of the kernel
# tree we already unpacked.

DOOM_URL := https://github.com/fifteenhex/doomgeneric.git
DOOM_REF := intern

DOOM_SRC := $(BUILDDIR)/doomgeneric
DOOM_TAR := $(CURDIR)/$(BUILDDIR)/doom.tar

# smolutils grafts extra tarballs onto the rootfs with tarmunge.
TARMUNGE_BIN := $(CURDIR)/$(TARWAK_SRC)/build/tarmunge

DOOM_INITRAMFS := $(CURDIR)/$(BUILDDIR)/x86_64-doom.cpio.gz

# Built by the main Makefile.
SMOLKVM := smolkvm_test_apic_libc
IPL     := ipl/build/ipl

# The virtio-gpu build, and where its smolrfb lives. Override SMOLRFBDIR if your
# checkout is somewhere else; the default assumes it sits beside this one.
SMOLKVM_GPU := smolkvm_test_apic_gpu_libc
SMOLRFBDIR  ?= $(CURDIR)/../smolrfb

SMOKE_TIMEOUT := 90
# Everything after `--` is passed to smolutils' init (see its README).
SMOKE_CMDLINE := console=ttyS0 earlycon=uart8250,io,0x3f8 -- smolinit.getty=/dev/ttyS0 smolinit.hostname=smolkvm
SMOKE_LOG     := $(BUILDDIR)/smoke.log
# smolsh prints "smolsh <cwd> > " once getty has a shell -- reaching it means we
# booted all the way to an interactive userspace.
SMOKE_MARKER  := smolsh

NPROC := $(shell nproc 2>/dev/null || echo 1)

# --- kernel source -----------------------------------------------------------

$(KERNEL_TARBALL):
	mkdir -p $(BUILDDIR)
	curl -fL --retry 3 --retry-delay 2 -o $@.tmp '$(KERNEL_URL)'
	mv $@.tmp $@

$(KERNEL_STAMP): $(KERNEL_TARBALL)
	rm -rf $(KERNEL_SRC)
	tar -C $(BUILDDIR) -xf $(KERNEL_TARBALL)
	touch $@

kernel-src: $(KERNEL_STAMP)
.PHONY: kernel-src

# --- vmlinux -----------------------------------------------------------------

$(VMLINUX): $(KERNEL_STAMP) $(CONFIG)
	$(MAKE) -C $(KERNEL_SRC) O=$(KOUT) allnoconfig KCONFIG_ALLCONFIG=$(CONFIG)
	$(MAKE) -C $(KERNEL_SRC) O=$(KOUT) -j$(NPROC) vmlinux

kernel: $(VMLINUX)
.PHONY: kernel

$(GPU_MERGED): $(CONFIG) $(GPU_CONFIG)
	mkdir -p $(BUILDDIR)
	cat $(CONFIG) $(GPU_CONFIG) > $@

$(GPU_VMLINUX): $(KERNEL_STAMP) $(GPU_MERGED)
	$(MAKE) -C $(KERNEL_SRC) O=$(GPU_KOUT) allnoconfig KCONFIG_ALLCONFIG=$(GPU_MERGED)
	$(MAKE) -C $(KERNEL_SRC) O=$(GPU_KOUT) -j$(NPROC) vmlinux

kernel-gpu: $(GPU_VMLINUX)
.PHONY: kernel-gpu

# --- smolutils initramfs -----------------------------------------------------

$(SMOLUTILS_SRC):
	git clone --depth 1 $(SMOLUTILS_URL) $@

$(TARWAK_SRC):
	git clone --depth 1 $(TARWAK_URL) $@

$(NOLIBCEXT_SRC):
	git clone --depth 1 $(NOLIBCEXT_URL) $@

$(TARWAK_BIN): | $(TARWAK_SRC)
	cd $(TARWAK_SRC) && meson setup build && meson compile -C build

# nolibc lives in the kernel tree, so that has to be unpacked first. NOPIE=1
# builds plain -static rather than static-PIE, which is what upstream nolibc
# (what the kernel tarball ships) supports.
$(INITRAMFS): $(KERNEL_STAMP) $(TARWAK_BIN) | $(SMOLUTILS_SRC) $(NOLIBCEXT_SRC)
	$(MAKE) -C $(SMOLUTILS_SRC) -f Makefile.x86_64 \
		UAPIDIR="$(SMOLUTILS_UAPI)" \
		NOLIBCDIR=$(NOLIBCDIR) \
		NOLIBCEXTDIR=$(NOLIBCEXTDIR) \
		CROSS_COMPILE=$(SMOLUTILS_CROSS) \
		TARWAK=$(TARWAK_BIN) \
		FEATURE_DISABLE=$(SMOLUTILS_FEATURE_DISABLE) \
		NOPIE=1 \
		x86_64.cpio.gz
	cp $(SMOLUTILS_CPIO) $@

initramfs: $(INITRAMFS)
.PHONY: initramfs

# --- doom --------------------------------------------------------------------

$(DOOM_SRC):
	git clone --depth 1 -b $(DOOM_REF) $(DOOM_URL) $@

# The kernel has to be unpacked first, for the nolibc. Always recursed into --
# doomgeneric knows what is stale.
$(DOOM_TAR): $(KERNEL_STAMP) | $(DOOM_SRC)
	$(MAKE) -C $(DOOM_SRC)/doomgeneric -f Makefile.rootfs \
		NOLIBCDIR=$(NOLIBCDIR) \
		TARBALL=$@
.PHONY: $(DOOM_TAR)

doom: $(DOOM_TAR)
.PHONY: doom

# The same smolutils rootfs with doom grafted on.
$(DOOM_INITRAMFS): $(KERNEL_STAMP) $(TARWAK_BIN) $(DOOM_TAR) | $(SMOLUTILS_SRC) $(NOLIBCEXT_SRC)
	$(MAKE) -C $(SMOLUTILS_SRC) -f Makefile.x86_64 \
		UAPIDIR="$(SMOLUTILS_UAPI)" \
		NOLIBCDIR=$(NOLIBCDIR) \
		NOLIBCEXTDIR=$(NOLIBCEXTDIR) \
		CROSS_COMPILE=$(SMOLUTILS_CROSS) \
		TARWAK=$(TARWAK_BIN) \
		TARMUNGE=$(TARMUNGE_BIN) \
		EXTRA_TARS=$(DOOM_TAR) \
		FEATURE_DISABLE=$(SMOLUTILS_FEATURE_DISABLE) \
		NOPIE=1 \
		x86_64.cpio.gz
	cp $(SMOLUTILS_CPIO) $@

doom-initramfs: $(DOOM_INITRAMFS)
.PHONY: doom-initramfs

# --- the smoke test ----------------------------------------------------------

# Build the smolkvm side via the main Makefile so we always test current code.
smolkvm-bits:
	$(MAKE) $(SMOLKVM) $(IPL)
.PHONY: smolkvm-bits

# Boot in the background and stop the moment the marker appears. SMOKE_TIMEOUT
# is only the failure cap.
smoke: $(VMLINUX) $(INITRAMFS) smolkvm-bits
	@echo "=== booting $(KERNEL_SRC) + smolutils under smolkvm ==="
	@rm -f $(SMOKE_LOG)
	@./$(SMOLKVM) -k $(VMLINUX) -r $(INITRAMFS) -c "$(SMOKE_CMDLINE)" \
		> $(SMOKE_LOG) 2>&1 & \
	pid=$$!; \
	ok=0; \
	for i in $$(seq 1 $(SMOKE_TIMEOUT)); do \
		if grep -q "$(SMOKE_MARKER)" $(SMOKE_LOG) 2>/dev/null; then ok=1; break; fi; \
		kill -0 $$pid 2>/dev/null || break; \
		sleep 1; \
	done; \
	kill $$pid 2>/dev/null; wait $$pid 2>/dev/null; \
	if [ $$ok = 1 ]; then \
		echo "SMOKE PASS (reached an interactive shell)"; \
	else \
		echo "SMOKE FAIL -- last lines of $(SMOKE_LOG):"; \
		tail -n 20 $(SMOKE_LOG); \
		exit 1; \
	fi
.PHONY: smoke

# --- the virtio-gpu smoke test -----------------------------------------------

GPU_SMOKE_LOG := $(BUILDDIR)/smoke-gpu.log
# fbcon binding to the virtio-gpu's fbdev emulation is the last link in the
# chain: the device answered, the driver probed, a mode was set and the console
# moved onto it.
GPU_SMOKE_MARKER := virtio_gpudrmfb

smolkvm-gpu-bits:
	$(MAKE) $(SMOLKVM_GPU) $(IPL) SMOLRFBDIR=$(SMOLRFBDIR)
.PHONY: smolkvm-gpu-bits

# Same shape as `smoke`, with the display attached and doom in the rootfs. The
# VNC server binds loopback; connect a viewer to :5900 while it runs to watch.
smoke-gpu: $(GPU_VMLINUX) $(DOOM_INITRAMFS) smolkvm-gpu-bits
	@echo "=== booting $(KERNEL_SRC) + smolutils + doom under smolkvm, with a display ==="
	@rm -f $(GPU_SMOKE_LOG)
	@./$(SMOLKVM_GPU) -k $(GPU_VMLINUX) -r $(DOOM_INITRAMFS) -c "$(SMOKE_CMDLINE)" \
		> $(GPU_SMOKE_LOG) 2>&1 & \
	pid=$$!; \
	ok=0; \
	for i in $$(seq 1 $(SMOKE_TIMEOUT)); do \
		if grep -q "$(GPU_SMOKE_MARKER)" $(GPU_SMOKE_LOG) 2>/dev/null; then ok=1; break; fi; \
		kill -0 $$pid 2>/dev/null || break; \
		sleep 1; \
	done; \
	kill $$pid 2>/dev/null; wait $$pid 2>/dev/null; \
	if [ $$ok = 1 ]; then \
		echo "GPU SMOKE PASS (the console is on the virtio-gpu)"; \
	else \
		echo "GPU SMOKE FAIL -- last lines of $(GPU_SMOKE_LOG):"; \
		tail -n 20 $(GPU_SMOKE_LOG); \
		exit 1; \
	fi
.PHONY: smoke-gpu

# --- running it, to actually look at -----------------------------------------

# console=tty0 puts the kernel log on the display; without it you get the boot
# logo on black and no way to tell a working display from a stuck one.
#
# Two gettys: one on the serial console and one on tty1, so the display has a
# shell on it rather than just the tail of the boot. tty1 shares the screen
# with printk, so a late message lands on top of the prompt.
RUN_CMDLINE ?= console=tty0 console=ttyS0 -- \
	       smolinit.getty=/dev/ttyS0 smolinit.getty=/dev/tty1
VNC_PORT    ?= 5900

define say_vnc
	@echo
	@echo "=== $(1)"
	@echo "=== point a VNC viewer at 127.0.0.1:$(VNC_PORT)"
	@echo "=== the guest console is here too; ctrl-c to stop"
	@echo
endef

# Boot Linux with the display and leave it running, which smoke-gpu does not:
# that one kills the VM as soon as its marker shows up. No doom in this
# rootfs, so it needs nothing unpublished.
run-gpu: $(GPU_VMLINUX) $(INITRAMFS) smolkvm-gpu-bits
	$(call say_vnc,booting $(KERNEL_SRC) + smolutils with a display)
	@./$(SMOLKVM_GPU) -k $(GPU_VMLINUX) -r $(INITRAMFS) \
		-c "$(RUN_CMDLINE)" -p $(VNC_PORT)
.PHONY: run-gpu

# ...and the same with doom in the rootfs.
run-doom: $(GPU_VMLINUX) $(DOOM_INITRAMFS) smolkvm-gpu-bits
	$(call say_vnc,booting $(KERNEL_SRC) + smolutils + doom with a display)
	@echo "=== at the smolsh prompt:"
	@echo "===     doom -iwad /usr/share/doom/doom1.wad"
	@echo
	@./$(SMOLKVM_GPU) -k $(GPU_VMLINUX) -r $(DOOM_INITRAMFS) \
		-c "$(RUN_CMDLINE)" -p $(VNC_PORT)
.PHONY: run-doom

# --- cleanup -----------------------------------------------------------------

# Build products, but keep the downloaded/cloned sources.
clean:
	rm -rf $(KOUT) $(GPU_KOUT) $(GPU_MERGED) $(SMOKE_LOG) $(GPU_SMOKE_LOG) \
		$(DOOM_TAR) $(DOOM_INITRAMFS)
	-$(MAKE) -C $(SMOLUTILS_SRC) -f Makefile.x86_64 \
		NOLIBCDIR=$(NOLIBCDIR) NOLIBCEXTDIR=$(NOLIBCEXTDIR) \
		CROSS_COMPILE=$(SMOLUTILS_CROSS) TARWAK=none clean 2>/dev/null
	-$(MAKE) -C $(DOOM_SRC)/doomgeneric -f Makefile.rootfs clean 2>/dev/null
.PHONY: clean

# Everything downloaded, unpacked, cloned or built. Nothing checked in lives
# under there, so this is always safe and always enough.
distclean:
	rm -rf $(BUILDDIR)
.PHONY: distclean
