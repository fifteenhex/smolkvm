# Minimal x86-64 kernel config for booting under smolkvm's APIC machine.
#
# Use as an allnoconfig fragment:
#   make allnoconfig KCONFIG_ALLCONFIG=/path/to/kernel.config
# (Makefile.test does this for you.) It produces a small vmlinux that boots the
# smolutils initramfs to a shell on ttyS0 -- no PCI, no disk, no network.

# 64-bit long mode (smolkvm enters the kernel in long mode)
CONFIG_64BIT=y

# ACPI: smolkvm's IPL hands the kernel a MADT/FADT; the kernel needs ACPI to
# find the LAPIC/IOAPIC.
CONFIG_ACPI=y

# Console: the only guest console is the legacy 8250 UART at 0x3f8 (ttyS0).
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# Root filesystem comes in as an initramfs (smolkvm loads it as the initrd).
# smolutils ships it gzip-compressed, so pull in the gzip decompressor.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y

# The filesystems smolutils' init mounts: devtmpfs (/dev), devpts (/dev/pts),
# proc, sysfs and tmpfs (/tmp, /run).
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y

# smolutils spawns a getty that drops to a normal user, so real multiuser.
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y

# Frame-pointer unwinder instead of ORC: a little smaller, and no ORC data to
# generate. (objtool itself is still built -- x86-64 always selects it -- so a
# libelf dev package is required to build; see Makefile.test.)
CONFIG_UNWINDER_FRAME_POINTER=y
# CONFIG_UNWINDER_ORC is not set
