# Kernel config fragment adding smolkvm's virtio-gpu to the base kernel.config.
#
# Use both as an allnoconfig fragment:
#   cat kernel.config kernel-gpu.config > merged
#   make allnoconfig KCONFIG_ALLCONFIG=merged
# (Makefile.test's `smoke-gpu` target does this for you.)

# The transport. There is no PCI and no device tree here, so the only way the
# kernel hears about the device is the command line -- which is what
# CMDLINE_DEVICES parses, and without it `virtio_mmio.device=` is ignored and
# nothing probes.
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y

# The driver, and the fbdev emulation that lets the console land on it.
# DRM_VIRTIO_GPU_KMS is default y, but allnoconfig does not care what anything
# defaults to: without it the driver probes, says "KMS disabled" and leaves a
# display with no modes.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_DRM_FBDEV_EMULATION=y

# ...and a console to put on the framebuffer. Without the VT layer the display
# comes up and stays blank, which looks exactly like a broken device.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# The boot logo. A tux in the corner says the whole path works -- the device
# answered, a mode was set, fbcon bound to it and the pixels reached a viewer
# -- before userspace has run at all.
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
